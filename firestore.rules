rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Entity validation helpers
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'targetDate', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'targetDate', 'targetScore', 'retentionMode', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == request.auth.uid
        && data.targetDate is string && data.targetDate.size() <= 64
        && (!('email' in data) || (data.email is string && data.email.size() <= 256))
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128))
        && (!('targetScore' in data) || (data.targetScore is number))
        && (!('retentionMode' in data) || (data.retentionMode in ['aggressive', 'balanced']));
    }

    function isValidStudyPlan(data) {
      return data.keys().hasAll(['id', 'userId', 'courseName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'userId', 'courseName', 'modulesCount', 'confidence', 'units', 'milestones', 'pacing', 'scheduleSlots', 'generatedSchedule', 'createdAt', 'updatedAt'])
        && data.id is string && isValidId(data.id)
        && data.userId is string && data.userId == request.auth.uid
        && data.courseName is string && data.courseName.size() <= 200
        && (!('units' in data) || (data.units is list && data.units.size() <= 50))
        && (!('milestones' in data) || (data.milestones is list && data.milestones.size() <= 50));
    }

    function isValidQuizResult(data) {
      return data.keys().hasAll(['id', 'userId', 'score', 'createdAt'])
        && data.keys().hasOnly(['id', 'userId', 'score', 'questionTitle', 'transcript', 'retentionDelta', 'correctInsights', 'spokenSummary', 'misconception', 'createdAt'])
        && data.id is string && isValidId(data.id)
        && data.userId is string && data.userId == request.auth.uid
        && data.score is number
        && (!('transcript' in data) || (data.transcript is string && data.transcript.size() <= 10000));
    }

    function isValidHandwrittenWork(data) {
      return data.keys().hasAll(['id', 'userId', 'score', 'createdAt'])
        && data.keys().hasOnly(['id', 'userId', 'score', 'maxScore', 'rubricMet', 'promptContext', 'pins', 'diagnosticSummary', 'pacing', 'createdAt'])
        && data.id is string && isValidId(data.id)
        && data.userId is string && data.userId == request.auth.uid
        && data.score is number
        && (!('pins' in data) || (data.pins is list && data.pins.size() <= 30));
    }

    // User Profile Document
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false; // Strict PII isolation, prevent enumerating user records
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming())
                    && incoming().uid == existing().uid;
      allow delete: if isOwner(userId) && isValidId(userId);

      // Subcollection: Study Plans
      match /studyPlans/{planId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(planId) && isValidStudyPlan(incoming());
        allow update: if isOwner(userId) && isValidId(planId) && isValidStudyPlan(incoming())
                      && incoming().id == existing().id && incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(planId);
      }

      // Subcollection: Quiz Results
      match /quizResults/{quizId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(quizId) && isValidQuizResult(incoming());
        allow update: if isOwner(userId) && isValidId(quizId) && isValidQuizResult(incoming())
                      && incoming().id == existing().id && incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(quizId);
      }

      // Subcollection: Handwritten Work
      match /handwrittenWork/{workId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(workId) && isValidHandwrittenWork(incoming());
        allow update: if isOwner(userId) && isValidId(workId) && isValidHandwrittenWork(incoming())
                      && incoming().id == existing().id && incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(workId);
      }

      // Subcollection: Voice Study Coach Sessions & Conversations
      match /voiceSessions/{sessionId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(sessionId);
        allow update: if isOwner(userId) && isValidId(sessionId);
        allow delete: if isOwner(userId) && isValidId(sessionId);
      }
    }
  }
}
