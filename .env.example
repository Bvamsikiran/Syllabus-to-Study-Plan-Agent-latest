# Gemini API Configuration
GEMINI_API_KEY=                         # Required: Server-side Gemini API Key (never exposed to browser)
GEMINI_LIVE_MODEL=gemini-2.0-flash-exp  # Configurable Live model: gemini-2.0-flash-exp or gemini-3.8-live

# Firebase Configuration
FIREBASE_API_KEY=                      # Web Client Firebase API Key for Firebase Authentication
FIREBASE_SERVICE_ACCOUNT_JSON=         # Server-side Firebase Admin SDK Service Account JSON string for token verification

PORT=3000

